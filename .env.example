# DevGraveyard Environment Variables
# Copy this file to .env.local and populate with your Firebase project credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: leave empty for standard default Firestore database
VITE_FIREBASE_DATABASE_ID=

# Optional: Gemini API Key for dynamic AI post-mortems
VITE_GEMINI_API_KEY=
