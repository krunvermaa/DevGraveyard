# ==============================================================================
# DevGraveyard Environment Variables Template
# Account: karan.verma.gj@gmail.com
# ==============================================================================
# Setup Instructions:
# 1. Open Firebase Console: https://console.firebase.google.com/
# 2. Select or create your Firebase project with account: karan.verma.gj@gmail.com
# 3. Enable Authentication -> Sign-in method -> Google (Support email: karan.verma.gj@gmail.com)
# 4. Enable Cloud Firestore database.
# 5. Add a Web App ("DevGraveyard") in Project Settings -> General -> Your apps.
# 6. Copy the values below into .env.local (or run ./scripts/bind-firebase.sh).
# ==============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Leave blank to use default Firestore database "(default)"
VITE_FIREBASE_DATABASE_ID=

# Optional: Google AI Studio Gemini API Key for dynamic AI project post-mortems
VITE_GEMINI_API_KEY=
