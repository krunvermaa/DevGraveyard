# ==============================================================================
# DevGraveyard Environment Variables Template
# ==============================================================================
# Setup Instructions:
# 1. Open Firebase Console: https://console.firebase.google.com/
# 2. Select or create your Firebase project.
# 3. Enable Authentication -> Sign-in methods (Google, GitHub).
# 4. Enable Cloud Firestore database.
# 5. Add a Web App ("DevGraveyard") in Project Settings -> General -> Your apps.
# 6. Copy the values below into .env.local (or run npm run firebase:bind).
# ==============================================================================

# Client-side Firebase credentials
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Leave blank to use default Firestore database "(default)"
VITE_FIREBASE_DATABASE_ID=

# ==============================================================================
# Server-side Environment Variables (Vercel Project Settings / Production)
# NOTE: Never expose your Gemini API Key in VITE_* client-side environment!
# Configure this in Vercel Dashboard -> Settings -> Environment Variables
# ==============================================================================
# GEMINI_API_KEY=your_google_ai_studio_api_key_here
